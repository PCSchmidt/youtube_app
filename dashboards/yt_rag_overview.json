          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(yt_rag_request_latency_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p50",
          "instant": false,
          "range": true
