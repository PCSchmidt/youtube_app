{
  "uid": "yt-rag-overview",
  "title": "yt_rag - RAG serving overview",
  "description": "yt_rag offline-first RAG serving: traffic, latency, errors, and retrieval PROXY signals (empty-result rate, mean top score, retrieved chunk count). The retrieval-quality panels are proxies, NOT answer quality: groundedness is a lexical heuristic and no quality measurement is claimed.",
  "tags": [
    "yt_rag",
    "rag",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "App health",
      "description": "1 = the yt_rag FastAPI app reports itself serving (scraped via /metrics/prometheus).",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yt-rag-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "thresholds",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yt-rag-prom"
          },
          "editorMode": "code",
          "expr": "yt_rag_up",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (all endpoints)",
      "description": "HTTP requests per second by endpoint over a 5m window. Scrape interval is 5s, so low local traffic shows as sparse spiky lines - expected, not a fault.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yt-rag-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "legendPlacement": "bottom",
            "axisPlacement": "auto"
          },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yt-rag-prom"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint) (rate(yt_rag_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (%)",
      "description": "Share of requests hitting a classified error (errors_total / requests_total). Thresholds: <5% green, 5-20% yellow, >20% red.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yt-rag-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "legendPlacement": "bottom",
            "axisPlacement": "auto"
          },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "min": 0
