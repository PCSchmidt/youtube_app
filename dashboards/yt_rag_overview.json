        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yt-rag-prom"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(yt_rag_errors_total[5m])) / sum(rate(yt_rag_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "error %",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
